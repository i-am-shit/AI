     return 'Tie'\n","    return None\n","\n","def print_board(board):\n","    \"\"\"Helper to display the 3x3 layout.\"\"\"\n","    for i in range(0, 9, 3):\n","        print(f\" {board[i]} | {board[i+1]} | {board[i+2]} \")\n","        if i < 6:\n","            print(\"-----------\")\n","\n","def explore_and_print_all_branches(board, current_path=[], turn='X'):\n","    \"\"\"\n","    Explores every complete permutation path, prints the final\n","    Tic Tac Toe board layout for that path, and returns win counts.\n","    \"\"\"\n","    available_moves = [i for i, cell in enumerate(board) if cell == ' ']\n","\n","\n","    if not available_moves:\n","        winner = check_winner(board)\n","\n","        print(f\"Path Sequence: {current_path} -> Winner: {winner}\")\n","\n","        print_board(board)\n","        return (1, 0) if winner == 'X' else (0, 1)\n","\n","    total_ai = 0\n","    total_human = 0\n","\n","    for move in available_moves:\n","        next_board = list(board)\n","        next_board[move] = turn\n","        ai_w, hum_w = explore_and_print_all_branches(\n","            next_board,\n","            current_path + [move],\n","            'O' if turn == 'X' else 'X'\n","        )\n","        total_ai += ai_w\n","        total_human += hum_w\n","\n","    return total_ai, total_human\n","\n","\n","initial_matrix = [\n","    'O', ' ', 'X',\n","    'X', ' ', ' ',\n","    'X', 'O', 'O'\n","]\n","\n","print(\" Step-by-Step Branch Tracing with Boards \")\n","ai_wins, human_wins = explore_and_print_all_branches(initial_matrix)\n","\n","\n","print(f\"Total AI ('X') Wins: {ai_wins}\")\n","print(f\"Total Human ('O') Wins: {human_wins}\")\n","print(\"Guaranteed Winning Paths for Human: [1, 4, 5] or [5, 4, 1]\")\n","print(\"AMSHITH 1WN24CS035\")\n"]}]}